    <string name="about_title">About</string>
    <string name="about_mission_title">Our mission</string>
    <string name="about_mission_text">To promote the seamless integration of autistic and neurodivergent individuals into community spaces, and to advocate for sensory-friendly environments where everyone belongs.</string>
    <string name="about_vision_title">Our vision</string>
    <string name="about_vision_text">A world where every mind belongs, and where autistic and neurodivergent people are valued and included in every space.</string>
    <string name="about_values_title">Our values</string>
    <string name="about_values_text">Community, acceptance, advocacy and awareness guide everything we do, from the events we host to the resources we share.</string>
