<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/settings_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="?android:colorBackground">

    <androidx.appcompat.widget.Toolbar
        android:id="@+id/toolbar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="?attr/actionBarSize"
        app:title="@string/settings_title"
        app:navigationIcon="?attr/homeAsUpIndicator"
        app:navigationContentDescription="@string/cd_back" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/settings_language"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:lineHeight="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_language_summary"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineHeight="20sp" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/language_field"
                style="@style/Widget.Material3.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:hint="@string/settings_language"
                app:hintAnimationEnabled="false">

                <AutoCompleteTextView
                    android:id="@+id/language_input"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:minHeight="48dp"
                    android:textSize="17sp" />
            </com.google.android.material.textfield.TextInputLayout>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/settings_appearance"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:lineHeight="24sp" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="@string/settings_appearance_summary"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineHeight="20sp" />

            <RadioGroup
                android:id="@+id/theme_group"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp">

                <RadioButton
                    android:id="@+id/theme_system"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_theme_system"
                    android:textSize="17sp" />

                <RadioButton
                    android:id="@+id/theme_light"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_theme_light"
                    android:textSize="17sp" />

                <RadioButton
                    android:id="@+id/theme_dark"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:text="@string/settings_theme_dark"
                    android:textSize="17sp" />
            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_sensory_mode"
                        android:textSize="17sp"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="?attr/colorOnSurface"
                        android:lineHeight="24sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_sensory_mode_summary"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineHeight="20sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/sensory_mode_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:contentDescription="@string/settings_sensory_mode" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="64dp"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:paddingEnd="16dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="@string/settings_haptics"
                        android:textSize="17sp"
                        android:fontFamily="@font/poppins_medium"
                        android:textColor="?attr/colorOnSurface"
                        android:lineHeight="24sp" />

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="2dp"
                        android:text="@string/settings_haptics_summary"
                        android:textSize="14sp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:lineHeight="20sp" />
                </LinearLayout>

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/haptics_switch"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:minHeight="48dp"
                    android:contentDescription="@string/settings_haptics" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/notifications_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textSize="17sp"
                android:text="@string/settings_notifications" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_notifications_summary"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineHeight="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/font_size_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textSize="17sp"
                android:text="@string/settings_font_size" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/settings_font_size_summary"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineHeight="20sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/clear_cache_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textSize="17sp"
                android:text="@string/settings_clear_cache" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/legal_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textSize="17sp"
                android:text="@string/settings_legal" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/staff_sign_out_button"
                style="@style/Widget.Material3.Button.TextButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:minHeight="56dp"
                android:gravity="start|center_vertical"
                android:textAlignment="viewStart"
                android:textSize="17sp"
                android:text="@string/settings_staff_sign_out"
                android:visibility="gone" />

            <TextView
                android:id="@+id/app_version"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:lineHeight="20sp" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
