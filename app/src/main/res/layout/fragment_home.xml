<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:id="@+id/offline_banner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:background="?attr/colorSecondaryContainer"
            android:padding="12dp"
            android:text="@string/offline_banner"
            android:textColor="?attr/colorOnSecondaryContainer"
            android:textSize="15sp"
            android:lineSpacingMultiplier="1.4"
            android:visibility="gone" />

        <TextView
            android:id="@+id/greeting"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/home_greeting_welcome"
            android:textSize="22sp"
            android:fontFamily="@font/poppins_semibold"
            android:textColor="?attr/colorOnSurface"
            android:lineHeight="30sp" />

        <LinearLayout
            android:id="@+id/next_event_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/next_event_background"
            android:foreground="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:padding="16dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="@string/home_next_event_label"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.4" />

            <TextView
                android:id="@+id/next_event_badge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:background="@drawable/badge_background"
                android:paddingStart="8dp"
                android:paddingEnd="8dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp"
                android:text="@string/event_happening_today"
                android:textColor="?attr/colorOnSecondaryContainer"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.4"
                android:visibility="gone" />

            <TextView
                android:id="@+id/next_event_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.4" />

            <TextView
                android:id="@+id/next_event_date"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:fontFamily="@font/poppins_medium"
            android:text="@string/home_quick_access"
            android:textColor="?attr/colorOnSurface"
            android:textSize="17sp"
            android:lineHeight="24sp" />

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:columnCount="2"
            android:alignmentMode="alignMargins"
            android:useDefaultMargins="true">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_events"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:minHeight="48dp"
                android:text="@string/tab_events"
                android:contentDescription="@string/cd_home_events" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_sensory"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:minHeight="48dp"
                android:text="@string/tab_sensory"
                android:contentDescription="@string/cd_home_sensory" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_resources"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:minHeight="48dp"
                android:text="@string/tab_resources"
                android:contentDescription="@string/cd_home_resources" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_donate"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:minHeight="48dp"
                android:text="@string/more_donate"
                android:contentDescription="@string/cd_home_donate" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_contact"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:minHeight="48dp"
                android:text="@string/more_contact"
                android:contentDescription="@string/cd_home_contact" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/quick_whatsapp"
                style="@style/Widget.Material3.Button.OutlinedButton"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:minHeight="48dp"
                android:text="@string/home_whatsapp"
                android:contentDescription="@string/cd_whatsapp" />
        </GridLayout>

        <LinearLayout
            android:id="@+id/latest_post_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:background="?attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:minHeight="48dp"
            android:orientation="vertical"
            android:paddingTop="8dp"
            android:paddingBottom="8dp"
            android:visibility="gone">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_medium"
                android:text="@string/home_latest_post"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:lineHeight="24sp" />

            <ImageView
                android:id="@+id/latest_post_image"
                android:layout_width="match_parent"
                android:layout_height="160dp"
                android:layout_marginTop="8dp"
                android:background="?attr/colorSecondaryContainer"
                android:contentDescription="@null"
                android:scaleType="centerCrop"
                android:visibility="gone" />

            <TextView
                android:id="@+id/latest_post_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:fontFamily="@font/poppins_semibold"
                android:textColor="?attr/colorOnSurface"
                android:textSize="17sp"
                android:lineSpacingMultiplier="1.4" />

            <TextView
                android:id="@+id/latest_post_meta"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="15sp"
                android:lineSpacingMultiplier="1.4" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
