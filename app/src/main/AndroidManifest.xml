<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!-- MediaPlayer.setWakeMode in the calming sounds tool, so a sound carries on playing when
         the screen goes off. Nothing else in the app holds a wake lock. -->
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <application
        android:name=".MainApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AutismAllyship">
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.AutismAllyship">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".FirstRunActivity"
            android:exported="false"
            android:parentActivityName=".SplashActivity" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:parentActivityName=".SplashActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".LegalActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".SiteWebViewActivity"
            android:exported="false"
            android:parentActivityName=".LegalActivity" />
        <activity
            android:name=".AboutActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ContactActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".ShopActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".GalleryActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".GalleryAlbumActivity"
            android:exported="false"
            android:parentActivityName=".GalleryActivity" />
        <activity
            android:name=".GalleryViewerActivity"
            android:exported="false"
            android:parentActivityName=".GalleryAlbumActivity" />
        <activity
            android:name=".PlaceholderActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ResourceDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".EventDetailActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".EventWebViewActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".EventRegistrationActivity"
            android:exported="false"
            android:parentActivityName=".EventDetailActivity" />
        <activity
            android:name=".BlogActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".BlogArticleActivity"
            android:exported="false"
            android:parentActivityName=".BlogActivity" />
        <activity
            android:name=".MyTicketsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".DonateActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".DonationCheckoutActivity"
            android:exported="false"
            android:parentActivityName=".DonateActivity" />
        <activity
            android:name=".DonationResultActivity"
            android:exported="false"
            android:parentActivityName=".DonateActivity" />
        <activity
            android:name=".BreathingActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".PopItActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".ShapeTracingActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".CalmingSoundsActivity"
            android:exported="false"
            android:parentActivityName=".MainActivity" />

        <!-- Exported because the whole point is that the link in the confirmation email opens
             here. autoVerify is on now that assetlinks.json is confirmed live at
             autism-allyship.pages.dev/.well-known/assetlinks.json, see CONSOLE-STEPS.md: the app
             opens directly instead of showing a chooser, for that exact host. Preview subdomains
             under the wildcard below have no assetlinks.json of their own, so a link to one of
             those still falls back to the chooser rather than failing outright. -->
        <activity
            android:name=".TicketDetailActivity"
            android:exported="true"
            android:parentActivityName=".MyTicketsActivity">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="autism-allyship.pages.dev" />
                <data android:host="*.autism-allyship.pages.dev" />
                <data android:path="/ticket.html" />
            </intent-filter>
        </activity>

        <!-- The scanner's only door in, RULES-APP.md section 7: reachable only by a deep link
             given to staff, no visible control anywhere in the normal UI. No real page is served
             at this path, the link only exists to be opened by this app; a device without the app
             installed gets nothing useful from it, which is acceptable for a staff-only tool.
             autoVerify is on, same reasoning and same assetlinks.json as the ticket link above. -->
        <activity
            android:name=".ScannerSignInActivity"
            android:exported="true">
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />

                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />

                <data android:scheme="https" />
                <data android:host="autism-allyship.pages.dev" />
                <data android:host="*.autism-allyship.pages.dev" />
                <data android:path="/scanner" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ScannerActivity"
            android:exported="false"
            android:parentActivityName=".ScannerSignInActivity" />
    </application>

</manifest>
